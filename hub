	-- Tab bar placement: Top / Bottom / Left / Right
	local TAB_BAR_H = 48
	local TAB_SIDE_W = 180
	local TOPBAR_H = 52

	local function ApplyTabLayout(pos, animate)
		Config.TabPosition = pos
		local horizontal = (pos == "Top" or pos == "Bottom")

		SideLayout.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
		if horizontal then
			SidePadding.PaddingTop = UDim.new(0, 7)
			SidePadding.PaddingBottom = UDim.new(0, 7)
			SidePadding.PaddingLeft = UDim.new(0, 6)
			SidePadding.PaddingRight = UDim.new(0, 6)
		else
			SidePadding.PaddingTop = UDim.new(0, 8)
			SidePadding.PaddingBottom = UDim.new(0, 0)
			SidePadding.PaddingLeft = UDim.new(0, 8)
			SidePadding.PaddingRight = UDim.new(0, 8)
		end

		for _, d in pairs(TabData) do
			d.btn.Size = horizontal and UDim2.new(1 / #Tabs, -5, 1, 0) or UDim2.new(1, 0, 0, 36)
			d.btn.Text = horizontal and d.short or d.full
			d.btn.TextXAlignment = horizontal and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
			d.pad.PaddingLeft = UDim.new(0, horizontal and 0 or 14)
			d.corner.CornerRadius = horizontal and UDim.new(1, 0) or UDim.new(0, 12)
			d.bar.Size = horizontal and UDim2.new(0.4, 0, 0, 3) or UDim2.new(0, 3, 0.6, 0)
			d.bar.Position = horizontal and UDim2.new(0.3, 0, 1, -5) or UDim2.new(0, -9, 0.2, 0)
		end

		local sideSize, sidePos, contentSize, contentPos
		if pos == "Top" then
			sideSize = UDim2.new(1, 0, 0, TAB_BAR_H)
			sidePos = UDim2.new(0, 0, 0, TOPBAR_H)
			contentSize = UDim2.new(1, 0, 1, -(TOPBAR_H + TAB_BAR_H))
			contentPos = UDim2.new(0, 0, 0, TOPBAR_H + TAB_BAR_H)
		elseif pos == "Bottom" then
			sideSize = UDim2.new(1, 0, 0, TAB_BAR_H)
			sidePos = UDim2.new(0, 0, 1, -TAB_BAR_H)
			contentSize = UDim2.new(1, 0, 1, -(TOPBAR_H + TAB_BAR_H))
			contentPos = UDim2.new(0, 0, 0, TOPBAR_H)
		elseif pos == "Left" then
			sideSize = UDim2.new(0, TAB_SIDE_W, 1, -TOPBAR_H)
			sidePos = UDim2.new(0, 0, 0, TOPBAR_H)
			contentSize = UDim2.new(1, -TAB_SIDE_W, 1, -TOPBAR_H)
			contentPos = UDim2.new(0, TAB_SIDE_W, 0, TOPBAR_H)
		else -- Right
			sideSize = UDim2.new(0, TAB_SIDE_W, 1, -TOPBAR_H)
			sidePos = UDim2.new(1, -TAB_SIDE_W, 0, TOPBAR_H)
			contentSize = UDim2.new(1, -TAB_SIDE_W, 1, -TOPBAR_H)
			contentPos = UDim2.new(0, 0, 0, TOPBAR_H)
		end

		if animate then
			TweenService:Create(Sidebar, EASE_SLIDE, { Size = sideSize, Position = sidePos }):Play()
			TweenService:Create(ContentArea, EASE_SLIDE, { Size = contentSize, Position = contentPos }):Play()
		else
			Sidebar.Size = sideSize
			Sidebar.Position = sidePos
			ContentArea.Size = contentSize
			ContentArea.Position = contentPos
		end
	end
	ApplyTabLayout(Config.TabPosition, false)

