	local hookedKillers = {}
	local function hookKillerEntity(entity)
		if hookedKillers[entity] or not entity:IsA("Model") or entity == LocalPlayer.Character then
			return
		end
		local hum = entity:FindFirstChildOfClass("Humanoid")
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if not animator then
			return -- Wait until Animator exists before marking hooked!
		end
		hookedKillers[entity] = true

		local function inParryRange()
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local eRoot = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart
			return myRoot and eRoot and ((myRoot.Position - eRoot.Position).Magnitude <= Config.AutoParryRange)
		end

		-- TEAM CHECK for this specific entity (teammates never trigger a parry)
		local function isEnemy()
			return (not Config.TeamCheck) or isHostile(entity)
		end

		local function canCounterName(lowerName)
			local classType = detectSurvivorClass(LocalPlayer.Character)
			if not classType then
				return false
			end
			if classType == "Jester" then
				return not isUndodgeableForJester(lowerName)
			end
			return not isUnparryableForKnight(lowerName)
		end

		-- Signal 1: Attack windup markers (ATKDISABLED / InMove)
		TrackConn(entity.ChildAdded:Connect(function(child)
			if not Config.AutoParryEnabled then
				return
			end
			if (child.Name == "ATKDISABLED" or child.Name == "InMove") and inParryRange() and isEnemy() then
				triggerParry()
			end
		end))

		-- Signal 2: AnimationPlayed (with AnimFolder ID classification so replicated "Animation" names are still filtered!)
		local locomotionIds = {}
		local meleeIds = {}
		local unparryableIds = {}
		local undodgeableIds = {}
		local animFolder = entity:FindFirstChild("AnimFolder")
		if animFolder then
			for _, a in ipairs(animFolder:GetDescendants()) do
				if a:IsA("Animation") and a.AnimationId ~= "" then
					local ln = string.lower(a.Name)
					if isNonAttackAnim(ln) then
						locomotionIds[a.AnimationId] = true
					else
						if isUndodgeableForJester(ln) then
							undodgeableIds[a.AnimationId] = true
						end
						if isUnparryableForKnight(ln) then
							unparryableIds[a.AnimationId] = true
						elseif isMeleeAttackName(ln) then
							meleeIds[a.AnimationId] = true
						end
					end
				end
			end
		end

		TrackConn(animator.AnimationPlayed:Connect(function(track)
			if not Config.AutoParryEnabled then
				return
			end
			if not isEnemy() then
				return
			end
			local animObj = track.Animation
			local animId = animObj and animObj.AnimationId or ""
			local numId = extractNumericId(animId)
			local animName = string.lower((animObj and animObj.Name) or track.Name or "")

			-- Explicit global ignore (both Knight & Jester)
			if numId ~= "" and BLOCKED_BOTH_IDS[numId] then
				return
			end

			-- Delayed-parry move: wait for animation to end, then parry once within 20-25 studs
			if numId ~= "" and DELAYED_PARRY_IDS[numId] then
				task.spawn(function()
					local startWait = os.clock()
					while track.IsPlaying and os.clock() - startWait < 5 do
						task.wait(0.02)
					end
					if not Config.AutoParryEnabled then
						return
					end
					-- Wait briefly for killer/hitbox to enter <= 25 studs (or trigger immediately if already <= 25)
					local postWait = os.clock()
					while os.clock() - postWait < 1.2 do
						local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						local eRoot = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart
						if myRoot and eRoot then
							local dist = (myRoot.Position - eRoot.Position).Magnitude
							if dist <= 25 then
								triggerParry()
								return
							end
						end
						task.wait(0.02)
					end
				end)
				return
			end

			if not inParryRange() then
				return
			end

			if (animId ~= "" and locomotionIds[animId]) or isNonAttackAnim(animName) then
				return
			end

			-- CLASS CHECK: nothing to do unless I'm really Knight / Jester
			local classType = detectSurvivorClass(LocalPlayer.Character)
			if not classType then
				return
			end
			if classType == "Jester" then
				if (animId ~= "" and undodgeableIds[animId]) or isUndodgeableForJester(animName) then
					return
				end
				local p = track.Priority
				local isAction = (
					p == Enum.AnimationPriority.Action
					or p == Enum.AnimationPriority.Action2
					or p == Enum.AnimationPriority.Action3
					or p == Enum.AnimationPriority.Action4
				)
				if (animId ~= "" and meleeIds[animId]) or isMeleeAttackName(animName) or isAction then
					triggerParry()
				end
			else
				-- Knight: strict check against unparryable IDs & names
				if (animId ~= "" and unparryableIds[animId]) or isUnparryableForKnight(animName) then
					return
				end
				if (animId ~= "" and meleeIds[animId]) or isMeleeAttackName(animName) then
					triggerParry()
				end
			end
		end))

		-- Signal 3: Attack sounds (filtered by class rules!)
		TrackConn(entity.DescendantAdded:Connect(function(desc)
			if not Config.AutoParryEnabled then
				return
			end
			if desc:IsA("Sound") then
				local lower = string.lower(desc.Name)
				if not canCounterName(lower) then
					return
				end
				if
					string.find(lower, "slash")
					or string.find(lower, "swing")
					or string.find(lower, "whoosh")
					or string.find(lower, "lunge")
					or string.find(lower, "attack")
					or string.find(lower, "bite")
					or string.find(lower, "claw")
				then
					if inParryRange() and isEnemy() then
						triggerParry()
					end
				end
			end
		end))
	end

