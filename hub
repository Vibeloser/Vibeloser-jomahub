    local function LoadImageSource(uri)
        if not uri or #uri == 0 then return "" end
        uri = string.gsub(uri, "^%s*(.-)%s*$", "%1")
        if string.sub(uri, 1, 11) == "rbxasset://" or string.sub(uri, 1, 12) == "rbxthumb://" or string.sub(uri, 1, 13) == "rbxassetid://" then
            return uri
        end
        local numOnly = string.match(uri, "^%d+$")
        if numOnly then
            return "rbxthumb://type=Asset&id=" .. numOnly .. "&w=768&h=432"
        end
        if string.find(uri, "roblox.com") then
            local extracted = string.match(uri, "(%d+)")
            if extracted then
                return "rbxthumb://type=Asset&id=" .. extracted .. "&w=768&h=432"
            end
        end
        if string.sub(uri, 1, 7) == "http://" or string.sub(uri, 1, 8) == "https://" then
            local customAssetFunc = getcustomasset or getsynasset
            if not customAssetFunc then return uri end
            
            bgFileCounter = bgFileCounter + 1
            local fileName = "vibecoded_bg_" .. tostring(os.time()) .. "_" .. tostring(bgFileCounter) .. ".png"
            local body = nil
            local ok, res = pcall(function() return game:HttpGet(uri) end)
            if ok and res and #res > 50 then
                body = res
            else
                local req = (syn and syn.request) or request or http_request
                if req then
                    pcall(function()
                        local response = req({Url = uri, Method = "GET"})
                        if response and response.StatusCode == 200 and response.Body and #response.Body > 50 then
                            body = response.Body
                        end
                    end)
                end
            end
            if body and #body > 50 then
                pcall(function()
                    if writefile then writefile(fileName, body) end
                end)
                local asset = customAssetFunc(fileName)
                if lastSavedBg and isfile and isfile(lastSavedBg) and delfile then
                    pcall(function() delfile(lastSavedBg) end)
                end
                lastSavedBg = fileName
                return asset
            end
            return nil
        end
        return uri
    end
    
