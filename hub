-- 360-Degree Target Finder
local function GetClosestTarget(folder)
    if not folder or not LocalPlayer.Character then return nil, math.huge end
    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local closest, minDist = nil, math.huge
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= LocalPlayer.Character then
            local hrp = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = model
                end
            end
        end
    end
    return closest, minDist
end

-- Status Billboards Updater
local activeBillboards = {}
local function UpdateBillboards(folder, roleColor, isKiller)
    if not folder then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, char in ipairs(folder:GetChildren()) do
        if char:IsA("Model") and char ~= LocalPlayer.Character then
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local bb = activeBillboards[char]
                if Config.ESPBoxes then
                    if not bb or bb.Parent ~= head then
                        if bb then bb:Destroy() end
                        bb = Instance.new("BillboardGui")
                        bb.Name = "VibeStatusBillboard"
                        bb.Adornee = head
                        bb.Size = UDim2.fromOffset(140, 44)
                        bb.StudsOffset = Vector3.new(0, 2.5, 0)
                        bb.AlwaysOnTop = true
                        bb.LightInfluence = 0
                        bb.MaxDistance = 600
                        bb.Parent = head
                        
                        local bg = Instance.new("Frame")
                        bg.Size = UDim2.fromScale(1, 1)
                        bg.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
                        bg.BackgroundTransparency = 0.3
                        bg.BorderSizePixel = 0
                        bg.Parent = bb
                        
                        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = bg
                        local s = Instance.new("UIStroke"); s.Color = roleColor; s.Thickness = 1.2; s.Parent = bg
                        
                        local nLbl = Instance.new("TextLabel")
                        nLbl.Name = "NameLabel"
                        nLbl.Size = UDim2.new(1, -8, 0, 18)
                        nLbl.Position = UDim2.new(0, 4, 0, 3)
                        nLbl.BackgroundTransparency = 1
                        nLbl.TextColor3 = roleColor
                        nLbl.Font = Enum.Font.GothamBold
                        nLbl.TextSize = 11
                        nLbl.TextTruncate = Enum.TextTruncate.AtEnd
                        nLbl.Parent = bg
                        
                        local sLbl = Instance.new("TextLabel")
                        sLbl.Name = "StatLabel"
                        sLbl.Size = UDim2.new(1, -8, 0, 16)
                        sLbl.Position = UDim2.new(0, 4, 0, 22)
                        sLbl.BackgroundTransparency = 1
                        sLbl.TextColor3 = Color3.fromRGB(241, 245, 249)
                        sLbl.Font = Enum.Font.GothamMedium
                        sLbl.TextSize = 10
                        sLbl.Parent = bg
                        
                        activeBillboards[char] = bb
                    end
                    local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0
                    local hp = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)
                    local roleTag = isKiller and "KILLER" or "SURVIVOR"
                    local nLbl = bb:FindFirstChild("NameLabel", true)
                    local sLbl = bb:FindFirstChild("StatLabel", true)
                    if nLbl then nLbl.Text = string.format("[%s] %s", roleTag, char.Name) end
                    if sLbl then sLbl.Text = string.format("%d studs • %d/%d HP", dist, hp, maxHp) end
                else
                    if bb then
                        bb:Destroy()
                        activeBillboards[char] = nil
                    end
                end
            elseif activeBillboards[char] then
                activeBillboards[char]:Destroy()
                activeBillboards[char] = nil
            end
        end
    end
end

-- RenderStepped Main Loop
local mainLoop = RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    
    fovCircle.Position = center
    fovCircle.Radius = Config.FOVRadius
    fovCircle.Visible = Config.ShowFOV
    
    -- Closest Killer Radar Tracking
    local closestKiller, killerDist = GetClosestTarget(workspace:FindFirstChild("Entities"))
    
    if closestKiller and killerDist < math.huge then
        local distStuds = math.floor(killerDist)
        if Config.ProximityAlert and distStuds <= Config.ProximityDist then
            DangerBanner.Visible = true
            DangerText.Text = string.format("⚠️ DANGER: %s IS %d STUDS AWAY!", closestKiller.Name, distStuds)
        else
            DangerBanner.Visible = false
        end
        
        local zone = "🟢 SAFE (>80m)"
        if distStuds < 40 then
            zone = "🔴 EXTREME DANGER (<40m)"
        elseif distStuds < 80 then
            zone = "🟡 CAUTION (40-80m)"
        end
        HC_Status.Text = string.format("Nearest Killer: %s (%d studs)\nSafety Zone: %s", closestKiller.Name, distStuds, zone)
        
        if Config.AutoEvade and myHum and distStuds <= Config.EvadeDistance then
            myHum.WalkSpeed = 65
        end
        
        if Config.EscapeVector and myRoot and closestKiller:FindFirstChild("HumanoidRootPart") then
            local awayDir = (myRoot.Position - closestKiller.HumanoidRootPart.Position).Unit
            local targetPoint = myRoot.Position + awayDir * 35
            local sp1, v1 = Camera:WorldToViewportPoint(myRoot.Position)
            local sp2, v2 = Camera:WorldToViewportPoint(targetPoint)
            if v1 and v2 then
                escapeLine.From = Vector2.new(sp1.X, sp1.Y)
                escapeLine.To = Vector2.new(sp2.X, sp2.Y)
                escapeLine.Visible = true
            else
                escapeLine.Visible = false
            end
        else
            escapeLine.Visible = false
        end
    else
        DangerBanner.Visible = false
        HC_Status.Text = "Nearest Killer: None detected\nSafety Zone: 🟢 SAFE (>80m)"
        escapeLine.Visible = false
    end
    
    -- 360-Degree Target Lock (Aim Assist)
    local targetFolder = GetTargetsFolder(Config.TargetRole)
    local closestSurv, survDist = GetClosestTarget(targetFolder)
    
    if closestSurv and survDist < math.huge then
        local sRoot = closestSurv:FindFirstChild("HumanoidRootPart")
        local sHum = closestSurv:FindFirstChildOfClass("Humanoid")
        TargetStatusLbl.Text = string.format("🎯 Locked Target: %s [%d studs away - %d HP]", closestSurv.Name, math.floor(survDist), sHum and math.floor(sHum.Health) or 0)
        
        if Config.PathPrediction and sRoot then
            local vel = sRoot.AssemblyLinearVelocity or sRoot.Velocity
            local predictedPos = sRoot.Position + (vel * 0.4)
            local p1, v1 = Camera:WorldToViewportPoint(sRoot.Position)
            local p2, v2 = Camera:WorldToViewportPoint(predictedPos)
            if v1 and v2 then
                predLine.From = Vector2.new(p1.X, p1.Y)
                predLine.To = Vector2.new(p2.X, p2.Y)
                predLine.Visible = true
            else
                predLine.Visible = false
            end
        else
            predLine.Visible = false
        end
        
        if Config.TargetLock and sRoot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local canLock = false
            if Config.Lock360 then
                canLock = true
            else
                local screenPos, onScreen = Camera:WorldToViewportPoint(sRoot.Position)
                if onScreen then
                    local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if distToCenter <= Config.FOVRadius then
                        canLock = true
                    end
                end
            end
            
            if canLock then
                local currentCF = Camera.CFrame
                local targetPos = sRoot.Position + Vector3.new(0, 1.5, 0)
                local targetCF = CFrame.lookAt(currentCF.Position, targetPos)
                local lerpFactor = math.clamp(Config.LockSmoothness / 10, 0.08, 0.95)
                Camera.CFrame = currentCF:Lerp(targetCF, lerpFactor)
            end
        end
        
        if Config.LookAtTarget and myRoot and sRoot then
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(sRoot.Position.X, myRoot.Position.Y, sRoot.Position.Z))
        end
        
        if Config.AutoSwing and survDist <= Config.AttackRange then
            if mouse1click then
                mouse1click()
            elseif VirtualInputManager then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
    else
        TargetStatusLbl.Text = "🎯 Locked Target: None [0m away]"
        predLine.Visible = false
    end
    
    -- ESP Highlights
    local function ManageESP(folder, color, enabled)
        if not folder then return end
        for _, char in ipairs(folder:GetChildren()) do
            if char:IsA("Model") and char ~= LocalPlayer.Character then
                local h = espHighlights[char]
                if enabled then
                    if not h or h.Parent ~= char then
                        h = Instance.new("Highlight")
                        h.FillColor = color
                        h.OutlineColor = Color3.fromRGB(255, 255, 255)
                        h.FillTransparency = 0.4
                        h.OutlineTransparency = 0
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = char
                        espHighlights[char] = h
                    end
                elseif h then
                    h:Destroy()
                    espHighlights[char] = nil
                end
            end
        end
    end
    ManageESP(workspace:FindFirstChild("Entities"), Color3.fromRGB(239, 68, 68), Config.AberrantESP)
    ManageESP(workspace:FindFirstChild("Survivors"), Color3.fromRGB(56, 189, 248), Config.SurvivorESP)
    
    -- Status Billboards Update
    UpdateBillboards(workspace:FindFirstChild("Entities"), Color3.fromRGB(239, 68, 68), true)
    UpdateBillboards(workspace:FindFirstChild("Survivors"), Color3.fromRGB(56, 189, 248), false)
    
    -- Movement Enforcement
    if Config.SpeedEnabled and myHum then
        myHum.WalkSpeed = Config.SpeedValue
    end
    if Config.JumpEnabled and myHum then
        myHum.UseJumpPower = true
        myHum.JumpPower = Config.JumpValue
    end
    if Config.AntiStagger and myHum then
        if myHum.WalkSpeed < Config.SpeedValue and Config.SpeedEnabled then
            myHum.WalkSpeed = Config.SpeedValue
        end
    end
end)
