        local targetPos = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        local targetSwitchColor = state and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(51, 65, 85)
