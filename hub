        TweenService:Create(card, TweenInfo.new(0.18), {BackgroundColor3 = targetCardColor, BackgroundTransparency = targetCardTrans}):Play()
        callback(state)
    end
    clickHitbox.Activated:Connect(ToggleState)
end

