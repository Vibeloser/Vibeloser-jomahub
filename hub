	local function ApplyBarriers(disable)
		local map = workspace:FindFirstChild("GameMap")
		if map then
			for _, folderName in ipairs({ "MapBarriers_Invisible", "MapBarriers_True" }) do
				local folder = map:FindFirstChild(folderName)
				if folder then
					for _, barrier in ipairs(folder:GetChildren()) do
						if barrier:IsA("BasePart") then
							barrier.CanCollide = not disable
						end
					end
				end
			end
		end
	end

