	-- AUTO PARRY (KNIGHT & JESTER)
	-- ==========================================
	local keyCodeToVirtual = {
		[Enum.KeyCode.Q] = 0x51,
		[Enum.KeyCode.E] = 0x45,
		[Enum.KeyCode.R] = 0x52,
		[Enum.KeyCode.F] = 0x46,
	}

	local lastParryTime = 0

	-- CLASS CHECK: what class am I REALLY playing? (nil = not Knight/Jester)
	local function getActualClass(char)
		if not char then
			return nil
		end
		local selected = char:GetAttribute("SelectedSurvivor")
		if selected == "Knight" or selected == "Jester" then
			return selected
		end
		if type(selected) == "string" and selected ~= "" then
			return nil -- explicitly a different class
		end
		local animFolder = char:FindFirstChild("AnimFolder")
		if animFolder then
			if animFolder:FindFirstChild("parry") or animFolder:FindFirstChild("parry_trigger") then
				return "Knight"
			end
			if animFolder:FindFirstChild("taunt1") or animFolder:FindFirstChild("cartwheel") then
				return "Jester"
			end
		end
		local attr = string.lower(tostring(char:GetAttribute("Character") or char:GetAttribute("Class") or char.Name))
		if string.find(attr, "jester") then
			return "Jester"
		end
		if string.find(attr, "knight") then
			return "Knight"
		end
		return nil
	end

	-- Returns the class auto parry should act as, or nil when auto parry must stay off
	local function detectSurvivorClass(char)
		local actual = getActualClass(char)
		if not actual then
			return nil
		end
		if Config.AutoParryClass ~= "Auto" then
			return Config.AutoParryClass
		end
		return actual
	end

	-- TEAM CHECK: player entities use their Team, NPC killers count as Adversaries
	local function entityTeam(model)
		local plr = Players:FindFirstChild(model.Name)
		if plr then
			return plr.Team
		end
		return Teams:FindFirstChild("Adversaries")
	end

	local function isHostile(model)
		local mine = LocalPlayer.Team
		if not mine or mine.Name == "Unassigned" then
			return true
		end
		local theirs = entityTeam(model)
		if not theirs then
			return true
		end
		return theirs ~= mine
	end

	-- true if at least one hostile entity is close enough to be the one attacking me
	local function hostileInRange()
		local ef = workspace:FindFirstChild("Entities")
		local myRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not (ef and myRootPart) then
			return true
		end
		local range = math.max(Config.AutoParryRange, 25) -- 25 covers the delayed-parry moves
		for _, m in ipairs(ef:GetChildren()) do
			if m:IsA("Model") and m ~= LocalPlayer.Character then
				local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
				local h = m:FindFirstChildOfClass("Humanoid")
				if r and (not h or h.Health > 0) and (r.Position - myRootPart.Position).Magnitude <= range then
					if isHostile(m) then
						return true
					end
				end
			end
		end
		return false
	end

	local function getAbilityFrame(abilityName)
		local pgui = LocalPlayer:FindFirstChild("PlayerGui")
		local controller = pgui and pgui:FindFirstChild("Controller")
		local main = controller and controller:FindFirstChild("MainFrame")
		local personal = main and main:FindFirstChild("PersonalInterface")
		local abilities = personal and personal:FindFirstChild("Abilities")
		local holder = abilities and abilities:FindFirstChild("AbilityHolder")
		return holder and holder:FindFirstChild(abilityName)
	end

	local function triggerParry()
		if not Config.AutoParryEnabled then
			return
		end
		local now = os.clock()
		if now - lastParryTime < Config.AutoParryCooldown then
			return
		end
		local myChar = LocalPlayer.Character
		if not myChar then
			return
		end
		-- Don't re-trigger if already deflecting / dodging
		if myChar:FindFirstChild("COUNTERITEM") or myChar:FindFirstChild("ALLCOUNTERITEM") or myChar:FindFirstChild("TRUECOUNTERITEM") then
			return
		end

		-- CLASS CHECK: only Knight / Jester may auto parry
		local classType = detectSurvivorClass(myChar)
		if not classType then
			return
		end
		-- TEAM CHECK: ignore teammates, need a hostile entity in range
		if Config.TeamCheck and not hostileInRange() then
			return
		end

		local abilityName = (classType == "Jester") and "Taunt" or "Parry"
		local abilityFrame = getAbilityFrame(abilityName)

		-- Skip if ability is currently on cooldown
		if abilityFrame then
			local cdText = abilityFrame:FindFirstChild("CooldownText")
			if cdText and cdText:IsA("TextLabel") then
				local cdNum = tonumber(cdText.Text)
				if cdNum and cdNum > 0 then
					return
				end
			end
		end

		lastParryTime = now

		task.spawn(function()
			if Config.AutoParryDelayMs > 0 then
				task.wait(Config.AutoParryDelayMs / 1000)
			end

			-- Resolve live keybind from AbilityHolder.<Parry/Taunt>.Keybind.TextLabel if present
			local keyCode = (classType == "Jester") and Config.JesterParryKey or Config.KnightParryKey
			if abilityFrame then
				local kb = abilityFrame:FindFirstChild("Keybind")
				local lbl = kb and kb:FindFirstChild("TextLabel")
				if lbl and lbl:IsA("TextLabel") and #lbl.Text == 1 then
					local okEnum, parsed = pcall(function()
						return Enum.KeyCode[string.upper(lbl.Text)]
					end)
					if okEnum and parsed then
						keyCode = parsed
					end
				end
			end

			-- 1) Try native key press through Local_Controller when Roblox is focused
			local vk = keyCodeToVirtual[keyCode]
			if not isrbxactive or isrbxactive() then
				if keypress and keyrelease and vk then
					keypress(vk)
					task.wait(0.03)
					keyrelease(vk)
				elseif VirtualInputManager then
					VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
					task.wait(0.03)
					VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
				end
				task.wait(0.04)
			end

			-- 2) If not active yet (or unfocused), invoke Activate RemoteFunction directly
			local curChar = LocalPlayer.Character
			local alreadyActive = curChar
				and (
					curChar:FindFirstChild("COUNTERITEM")
					or curChar:FindFirstChild("ALLCOUNTERITEM")
					or curChar:FindFirstChild("TRUECOUNTERITEM")
				)
			if not alreadyActive then
				local activateRemote = abilityFrame and abilityFrame:FindFirstChild("Activate")
				if activateRemote and activateRemote:IsA("RemoteFunction") then
					pcall(function()
						activateRemote:InvokeServer()
					end)
				end
			end
		end)
	end

