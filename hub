        local targetStrokeTrans = state and 0.1 or 0.65
        local targetCardColor = state and Color3.fromRGB(16, 185, 129) or Color3.fromRGB(20, 30, 48)
        local targetCardTrans = state and 0.70 or 0.85
        
        TweenService:Create(indicator, TweenInfo.new(0.18), {Position = targetPos}):Play()
        TweenService:Create(pillSwitch, TweenInfo.new(0.18), {BackgroundColor3 = targetSwitchColor}):Play()
