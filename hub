	local function getClosestInFolder(folder, myRootPos)
		if not folder or not myRootPos then
			return nil, math.huge
		end
		local closest, minDist = nil, math.huge
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and model ~= LocalPlayer.Character then
				local hrp = model:FindFirstChild("HumanoidRootPart")
				local hum = model:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local dist = (hrp.Position - myRootPos).Magnitude
					if dist < minDist then
						minDist = dist
						closest = model
					end
				end
			end
		end
		return closest, minDist
	end

	-- ==========================================
	-- MAIN RENDER LOOP (ZERO BLOCKING, CACHED)
	-- ==========================================
	local lastTelemetryUpdate = 0
	local lastSwingTime = 0
	local hitNotes = setmetatable({}, { __mode = "k" })
	local holdingBlue = false
	local holdingRed = false

	local function setMouseHold(isRed, down)
		if isRed then
			if holdingRed == down then
				return
			end
			holdingRed = down
			if down then
				if mouse2press then
					mouse2press()
				elseif VirtualInputManager then
					VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 0)
				end
			else
				if mouse2release then
					mouse2release()
				elseif VirtualInputManager then
					VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
				end
			end
		else
			if holdingBlue == down then
				return
			end
			holdingBlue = down
			if down then
				if mouse1press then
					mouse1press()
				elseif VirtualInputManager then
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				end
			else
				if mouse1release then
					mouse1release()
				elseif VirtualInputManager then
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
				end
			end
		end
	end

	local function tapMouse(isRed)
		if isRed then
			if mouse2click then
				mouse2click()
			elseif VirtualInputManager then
				task.spawn(function()
					VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 0)
					task.wait(0.02)
					VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
				end)
			end
		else
			if mouse1click then
				mouse1click()
			elseif VirtualInputManager then
				task.spawn(function()
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
					task.wait(0.02)
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
				end)
			end
		end
	end

	TrackConn(RunService.RenderStepped:Connect(function(dt)
		local Camera = workspace.CurrentCamera
		if not Camera then
			return
		end

		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local myRootPos = myRoot and myRoot.Position

		local entitiesFolder = workspace:FindFirstChild("Entities")
		local survivorsFolder = workspace:FindFirstChild("Survivors")

		local vp = Camera.ViewportSize
		local center = Vector2.new(vp.X / 2, vp.Y / 2)

		fovCircle.Position = center
		fovCircle.Radius = Config.FOVRadius
		fovCircle.Color = Config.AccentColor
		fovCircle.Visible = Config.ShowFOV

		-- Closest killer
		local closestKiller, killerDist = getClosestInFolder(entitiesFolder, myRootPos)
		if closestKiller and killerDist < math.huge then
			local distStuds = math.floor(killerDist)
			if Config.ProximityAlert and distStuds <= Config.ProximityDist then
				DangerBanner.Visible = true
				DangerText.Text = string.format("⚠️ DANGER: %s IS %d STUDS AWAY!", closestKiller.Name, distStuds)
			else
				DangerBanner.Visible = false
			end

			local zone = (distStuds < 40 and "🔴 EXTREME DANGER (<40m)")
				or (distStuds < 80 and "🟡 CAUTION (40-80m)")
				or "🟢 SAFE (>80m)"
			HC_Status.Text = string.format("Nearest Killer: %s (%d studs)\nSafety Zone: %s", closestKiller.Name, distStuds, zone)

			local kRoot = closestKiller:FindFirstChild("HumanoidRootPart")
			if Config.Tracers and kRoot then
				local sp, onScreen = Camera:WorldToViewportPoint(kRoot.Position)
				if onScreen and sp.Z > 0 then
					tracerLine.From = Vector2.new(center.X, vp.Y)
					tracerLine.To = Vector2.new(sp.X, sp.Y)
					tracerLine.Color = Config.KillerESPColor
					tracerLine.Visible = true
				else
					tracerLine.Visible = false
				end
			else
				tracerLine.Visible = false
			end

			if Config.AutoEvade and myHum and distStuds <= Config.EvadeDistance then
				myHum.WalkSpeed = 65
			end

			if Config.EscapeVector and myRoot and kRoot then
				local awayDir = (myRoot.Position - kRoot.Position).Unit
				local targetPoint = myRoot.Position + awayDir * 35
				local sp1, v1 = Camera:WorldToViewportPoint(myRoot.Position)
				local sp2, v2 = Camera:WorldToViewportPoint(targetPoint)
				if v1 and v2 then
					escapeLine.From = Vector2.new(sp1.X, sp1.Y)
					escapeLine.To = Vector2.new(sp2.X, sp2.Y)
					escapeLine.Visible = true
				else
					escapeLine.Visible = false
				end
			else
				escapeLine.Visible = false
			end
		else
			DangerBanner.Visible = false
			tracerLine.Visible = false
			escapeLine.Visible = false
			HC_Status.Text = "Nearest Killer: None detected\nSafety Zone: 🟢 SAFE (>80m)"
		end

		-- Killer's Helper (Target Lock + AutoSwing)
		local targetFolder = (Config.TargetRole == "Survivors") and survivorsFolder or entitiesFolder
		local closestTarget, targetDist = getClosestInFolder(targetFolder, myRootPos)
		if closestTarget and targetDist < math.huge then
			local sRoot = closestTarget:FindFirstChild("HumanoidRootPart")
			local sHum = closestTarget:FindFirstChildOfClass("Humanoid")
			TargetStatusLbl.Text = string.format(
				"🎯 Locked Target: %s [%d studs - %d HP]",
				closestTarget.Name,
				math.floor(targetDist),
				sHum and math.floor(sHum.Health) or 0
			)

			if Config.PathPrediction and sRoot then
				local vel = sRoot.AssemblyLinearVelocity
				local predictedPos = sRoot.Position + (vel * 0.4)
				local p1, v1 = Camera:WorldToViewportPoint(sRoot.Position)
				local p2, v2 = Camera:WorldToViewportPoint(predictedPos)
				if v1 and v2 then
					predLine.From = Vector2.new(p1.X, p1.Y)
					predLine.To = Vector2.new(p2.X, p2.Y)
					predLine.Visible = true
				else
					predLine.Visible = false
				end
			else
				predLine.Visible = false
			end

			local aimPos = sRoot and sRoot.Position or Vector3.zero
			if sRoot and Config.AimPrediction then
				local vel = sRoot.AssemblyLinearVelocity
				aimPos = aimPos + (vel * (Config.PredictionMs / 1000))
			end

			if Config.TargetLock and sRoot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				local canLock = Config.Lock360
				if not canLock then
					local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
					if onScreen and (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude <= Config.FOVRadius then
						canLock = true
					end
				end
				if canLock then
					local currentCF = Camera.CFrame
					local targetCF = CFrame.lookAt(currentCF.Position, aimPos + Vector3.new(0, 1.5, 0))
					local lerpFactor = math.clamp(Config.LockSmoothness / 10, 0.08, 0.95)
					Camera.CFrame = currentCF:Lerp(targetCF, lerpFactor)
				end
			end

			if Config.LookAtTarget and myRoot and sRoot then
				myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(aimPos.X, myRoot.Position.Y, aimPos.Z))
			end

			if Config.AutoSwing and targetDist <= Config.AttackRange and (os.clock() - lastSwingTime >= 0.2) then
				lastSwingTime = os.clock()
				if mouse1click then
					mouse1click()
				elseif VirtualInputManager then
					task.spawn(function()
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
						task.wait(0.03)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
					end)
				end
			end
		else
			TargetStatusLbl.Text = "🎯 Locked Target: None [0m away]"
			predLine.Visible = false
		end

		-- Vocalist Auto Play (RhythmGame)
		local pgui = LocalPlayer:FindFirstChild("PlayerGui")
		local rhythmGui = Config.VocalistAutoPlay and pgui and pgui:FindFirstChild("RhythmGame")
		local judgeFrame = rhythmGui and rhythmGui:FindFirstChild("Judge")
		if judgeFrame and (not isrbxactive or isrbxactive()) then
			local wantHoldBlue = false
			local wantHoldRed = false
			for _, note in ipairs(judgeFrame:GetChildren()) do
				if note:IsA("GuiObject") and note.Name ~= "Holdler" and not note:HasTag("Missed") then
					local name = note.Name
					local isHold = (name == "HoldNote" or name == "HoldNoteSegment")
					if name == "Note" or isHold then
						local scaleX = note.Position.X.Scale
						local distToCenter = math.abs(scaleX - 0.5)
						local col = note.BackgroundColor3
						local isRed = col.R > col.B
						if isHold then
							if distToCenter <= 0.12 then
								if isRed then
									wantHoldRed = true
								else
									wantHoldBlue = true
								end
							end
						elseif distToCenter <= 0.04 and not hitNotes[note] then
							hitNotes[note] = true
							tapMouse(isRed)
						end
					end
				end
			end
			setMouseHold(false, wantHoldBlue)
			setMouseHold(true, wantHoldRed)
		else
			setMouseHold(false, false)
			setMouseHold(true, false)
		end

		-- Fast ESP + Billboards + AutoParry hook registration
		local function processFolder(folder, isKillerFolder)
			if not folder then
				return
			end
			for _, char in ipairs(folder:GetChildren()) do
				if char:IsA("Model") and char ~= myChar then
					if isKillerFolder then
						hookKillerEntity(char)
					end
					local hum = char:FindFirstChildOfClass("Humanoid")
					local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
					local alive = head and hum and hum.Health > 0

					if not alive then
						cleanupDeadEntry(char)
					else
						local isAdversary = isKillerFolder and (char:HasTag("Adversary") or char:GetAttribute("IsAdversary"))
						local hlEnabled = isKillerFolder
								and ((isAdversary and Config.AdversaryESP) or (not isAdversary and Config.AberrantESP))
							or (not isKillerFolder and Config.SurvivorESP)
						local roleColor = isKillerFolder
								and (isAdversary and Config.AdversaryESPColor or Config.KillerESPColor)
							or Config.SurvivorESPColor

						local hl = espHighlights[char]
						if hlEnabled then
							if not hl or hl.Parent ~= char then
								hl = Instance.new("Highlight")
								hl.Name = "VibeHighlight"
								hl.OutlineColor = Color3.fromRGB(255, 255, 255)
								hl.FillTransparency = 0.4
								hl.OutlineTransparency = 0
								hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								hl.Parent = char
								espHighlights[char] = hl
							end
							hl.FillColor = roleColor
						elseif hl then
							hl:Destroy()
							espHighlights[char] = nil
						end

						if Config.ESPBoxes then
							local entry = getOrCreateBillboard(char, head, roleColor)
							local dist = myRootPos and math.floor((head.Position - myRootPos).Magnitude) or 0
							local tag = isKillerFolder and (isAdversary and "ADVERSARY" or "KILLER") or "SURVIVOR"
							entry.nLbl.Text = string.format("[%s] %s", tag, char.Name)
							entry.nLbl.TextColor3 = roleColor
							entry.sLbl.Text = string.format("%d studs • %d/%d HP", dist, math.floor(hum.Health), math.floor(hum.MaxHealth))
							entry.bs.Color = roleColor
						elseif activeBillboards[char] then
							activeBillboards[char].bb:Destroy()
							activeBillboards[char] = nil
						end
					end
				end
			end
		end

		processFolder(entitiesFolder, true)
		processFolder(survivorsFolder, false)

		-- Movement overrides
		if myHum then
			if Config.SpeedEnabled and not (Config.AutoEvade and killerDist <= Config.EvadeDistance) then
				myHum.WalkSpeed = Config.SpeedValue
			elseif Config.AntiStagger and Config.SpeedEnabled and myHum.WalkSpeed < Config.SpeedValue then
				myHum.WalkSpeed = Config.SpeedValue
			end
			if Config.JumpEnabled then
				myHum.UseJumpPower = true
				myHum.JumpPower = Config.JumpValue
			end
		end

		-- Flight Mode (smooth & responsive)
		if Config.FlyEnabled and myRoot then
			if myHum then
				myHum.PlatformStand = true
			end
			local moveVec = Vector3.zero
			local camCF = Camera.CFrame
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				moveVec += camCF.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				moveVec -= camCF.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				moveVec -= camCF.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				moveVec += camCF.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				moveVec += Vector3.new(0, 1, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
				moveVec -= Vector3.new(0, 1, 0)
			end
			if moveVec.Magnitude > 0 then
				moveVec = moveVec.Unit * Config.FlySpeed
			end
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.CFrame = myRoot.CFrame + (moveVec * dt)
		end

		-- Throttled Telemetry & Ambience updates (4x/sec instead of 150x/sec!)
		local now = os.clock()
		if now - lastTelemetryUpdate >= 0.25 then
			lastTelemetryUpdate = now

			FooterLbl.Text = string.format("⚡ %d FPS • %d ms", math.floor(1 / math.max(dt, 1e-3)), math.floor(LocalPlayer:GetNetworkPing() * 1000))

			if Config.Fullbright then
				Lighting.Ambient = Color3.fromRGB(185, 185, 185)
				Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
				Lighting.Brightness = 2
				Lighting.ClockTime = 14
			end
			if Config.CleanScreenFX then
				pcall(function()
					local pgui = LocalPlayer:FindFirstChild("PlayerGui")
					local pg = pgui and pgui:FindFirstChild("PlayerGui")
					if pg then
						for _, fxName in ipairs({ "Hurt_1", "Hurt_2", "ChaseVignette" }) do
							local fx = pg:FindFirstChild(fxName)
							if fx then
								fx.Visible = false
							end
						end
					end
					local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect")
					if dof then
						dof.Enabled = false
					end
				end)
			end

			local survCount, killerCount = 0, 0
			local survLines, killerLines = {}, {}
			if survivorsFolder then
				for _, m in ipairs(survivorsFolder:GetChildren()) do
					local h = m:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						survCount += 1
						local pct = math.floor((h.Health / math.max(1, h.MaxHealth)) * 100)
						local warnTag = (Config.MedAlert and pct <= 40) and " ⚠️LOW" or ""
						table.insert(survLines, string.format("• %s: %d/%d HP (%d%%)%s", m.Name, math.floor(h.Health), math.floor(h.MaxHealth), pct, warnTag))
					end
				end
			end
			if entitiesFolder then
				for _, m in ipairs(entitiesFolder:GetChildren()) do
					local h = m:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						killerCount += 1
						local r = m:FindFirstChild("HumanoidRootPart")
						local d = (myRootPos and r) and math.floor((r.Position - myRootPos).Magnitude) or 0
						table.insert(killerLines, string.format("• %s (%d studs)", m.Name, d))
					end
				end
			end

			RO_Body.Text = string.format(
				"Phase: %s\nAlive Survivors: %d | Active Killers: %d\nAuto Parry: %s (%s)",
				tostring(workspace:GetAttribute("LMS_State") and "LMS" or "In Match"),
				survCount,
				killerCount,
				Config.AutoParryEnabled and "ON" or "OFF",
				tostring(getActualClass(myChar) or "Unsupported class")
			)
			RosterBody.Text = (#survLines > 0) and table.concat(survLines, "\n") or "No alive survivors detected."
			ThreatBody.Text = (#killerLines > 0) and table.concat(killerLines, "\n") or "No active killers detected."
		end
	end))

	TrackConn(UserInputService.JumpRequest:Connect(function()
		if Config.InfiniteJump and LocalPlayer.Character then
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end))

	TrackConn(RunService.Stepped:Connect(function()
		if Config.Noclip and LocalPlayer.Character then
			for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end))

	return true
end)
return { success = success, err = tostring(err) }
